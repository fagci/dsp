 // \u0437\u0430\u043f\u0430\u0441\u0443 \u0432 \u043a\u043e\u043b\u044c\u0446\u0435 (\u0435\u0433\u043e \u043c\u0438\u043d\u0438\u043c\u0443\u043c\u0443 \u0437\u0430 0.5 \u0441) \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u00b1IQA_MAX_PPM. \u041d\u0435\u0434\u043e\u0431\u043e\u0440 \u2014 \u0442\u0438\u0448\u0438\u043d\u0430 \u0434\u043e
